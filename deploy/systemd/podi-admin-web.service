[Unit]
Description=PODI Admin Web Static Proxy
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/pod
ExecStart=/usr/bin/env node /srv/pod/scripts/node_static_proxy.mjs --root /srv/pod/podi-admin-web/dist --port 8199 --api http://127.0.0.1:8099
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
