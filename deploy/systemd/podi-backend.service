[Unit]
Description=PODI Backend API
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/pod/backend
EnvironmentFile=/srv/pod/backend/.env
ExecStart=/srv/pod/backend/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8099
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
