[Unit]
Description=PODI Image Ops Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/pod/image-ops-service
EnvironmentFile=/srv/pod/image-ops-service/.env
ExecStart=/srv/pod/image-ops-service/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8301
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
