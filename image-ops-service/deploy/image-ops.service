[Unit]
Description=PODI Image Ops Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/pod/image-ops-service
EnvironmentFile=/srv/pod/image-ops-service/.env
ExecStart=/bin/bash -lc 'exec /srv/pod/image-ops-service/.venv/bin/python -m uvicorn app.main:app --host "${IMAGE_OPS_HOST:-127.0.0.1}" --port "${IMAGE_OPS_PORT:-8301}"'
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
