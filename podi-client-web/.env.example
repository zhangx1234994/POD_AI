# PODI client runtime configuration.
# Copy to `.env.local` for local real-chain testing. Do not commit real keys.

# Client business API base. This is not the 8099 mid-platform.
VITE_PODI_API_BASE=http://127.0.0.1:8240

# Media upload base. Local real-chain testing uses the client business API,
# which stores files and passes public URLs to the mid-platform.
VITE_PODI_MEDIA_BASE=http://127.0.0.1:8240/api/media

# Business operation base. The business API proxies mid-platform abilities when configured.
VITE_PODI_BUSINESS_BASE=http://127.0.0.1:8240

# Business API key for /api/business/* calls.
VITE_PODI_API_KEY=
