{
  "name": "podi-client-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8210",
    "build": "tsc && vite build",
    "preview": "vite preview --port 4210",
    "lint": "tsc --noEmit --pretty false",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "selftest:remote": "node scripts/client_remote_selftest.mjs",
    "selfcheck:local": "npm run lint && npm run build && npm run test:ui",
    "selfcheck:full": "npm run selfcheck:local && npm run selftest:remote"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "tdesign-icons-react": "^0.6.2",
    "tdesign-react": "^1.16.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.2",
    "vite": "^6.3.5"
  }
}
